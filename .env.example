# === Database ===
# SQLite is the approved database (confirmed by management) - not a temporary
# stand-in for Postgres. DATABASE_URL below is only used by the Prisma CLI
# (migrate/studio) and points at a local file; the app itself connects via
# lib/prisma.ts's driver adapter, which prefers TURSO_* below when set.
DATABASE_URL="file:./dev.db"

# Turso (hosted libSQL - still SQLite dialect) is how CTO and PR share the
# same live data instead of each reading their own machine's file. Leave both
# blank for solo local dev - lib/prisma.ts falls back to the local file above.
# Create a database at https://turso.tech (or `turso db create` via their
# CLI), then fill these in from the dashboard / `turso db show` + `turso db
# tokens create`:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# === Admin console (individual accounts - CTO handoff doc v3 §6.9) ===
# Random 32+ char secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"

# Only used once, by `npm run seed:admin`, to create the first CTO account -
# after that, create every other account (including further CTO accounts)
# from /admin/accounts, not via env vars. Not read by the app at runtime.
INITIAL_CTO_EMAIL="cto@example.com"
INITIAL_CTO_PASSWORD="change-me-then-forget-it"

# === CTO-only export (data-export capability) ===
# Separate from admin session auth on purpose - a PR-role login must never unlock this.
EXPORT_TOKEN="change-me-cto-only"

# === GTM / GA4 (owned by Lindy, see CTO handoff doc §3) ===
# Leave unset and the site simply won't inject GTM - nothing breaks.
NEXT_PUBLIC_GTM_ID=""
# GA4 measurement ID is configured *inside* GTM, not read directly by this app -
# recorded here only so it's easy to find when Lindy hands it over.
NEXT_PUBLIC_GA4_ID=""

# === Meta Pixel / CAPI (owned by PR/公關, see CTO handoff doc §5) ===
# Client-side pixel ID also goes through GTM. This is only the server-side CAPI token.
META_CAPI_TOKEN=""
META_PIXEL_ID=""

# === Transactional email (owned by the company, see CTO handoff doc §6.5) ===
# EMAIL_PROVIDER=none -> log-only, no external call, safe default until an account exists.
EMAIL_PROVIDER="none"
RESEND_API_KEY=""
EMAIL_FROM="Agatha 湧現智庫 <service@emergence.today>"

# === Ragic (owned by BD/Lindy, see CTO handoff doc §6.2) ===
# Leave unset and the sync stub simply logs and no-ops.
RAGIC_API_TOKEN=""
RAGIC_BASE_URL=""
