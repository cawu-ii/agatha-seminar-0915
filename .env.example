# === Database ===
# Local/staging default: sqlite, zero setup, matches prisma/schema.prisma's current
# provider. If Docker is available: `docker compose up -d` starts a local Postgres
# you can point at instead (see README "Known deviations" for why sqlite is the
# default right now). Production target is Supabase Postgres - swap both this URL
# and prisma/schema.prisma's datasource provider back to "postgresql" first.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://agatha:agatha_local_dev@localhost:5432/agatha_seminar"

# === Admin console (V1: single shared password) ===
# Pick a real password before sharing the staging URL with PR. Change it before production.
ADMIN_PASSWORD="change-me"
# Random 32+ char secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"

# === CTO-only export (data-export capability) ===
# Separate from ADMIN_PASSWORD on purpose - PR's shared password must never unlock this.
EXPORT_TOKEN="change-me-cto-only"

# === GTM / GA4 (owned by Lindy, see CTO handoff doc §3) ===
# Leave unset and the site simply won't inject GTM - nothing breaks.
NEXT_PUBLIC_GTM_ID=""
# GA4 measurement ID is configured *inside* GTM, not read directly by this app -
# recorded here only so it's easy to find when Lindy hands it over.
NEXT_PUBLIC_GA4_ID=""

# === Meta Pixel / CAPI (owned by PR/公關, see CTO handoff doc §5) ===
# Client-side pixel ID also goes through GTM. This is only the server-side CAPI token.
META_CAPI_TOKEN=""
META_PIXEL_ID=""

# === Transactional email (owned by the company, see CTO handoff doc §6.5) ===
# EMAIL_PROVIDER=none -> log-only, no external call, safe default until an account exists.
EMAIL_PROVIDER="none"
RESEND_API_KEY=""
EMAIL_FROM="Agatha 湧現智庫 <service@emergence.today>"

# === Ragic (owned by BD/Lindy, see CTO handoff doc §6.2) ===
# Leave unset and the sync stub simply logs and no-ops.
RAGIC_API_TOKEN=""
RAGIC_BASE_URL=""
