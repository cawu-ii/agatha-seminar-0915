generator client {
  provider = "prisma-client-js"
}

// SQLite is the approved production datasource (confirmed by management) -
// not a temporary deviation. Shared/multi-user access (CTO + PR both hitting
// /admin against the same live data) is served via Turso (hosted libSQL,
// still SQLite dialect) through the driver adapter in lib/prisma.ts. The
// `url` below is only used by the Prisma CLI (migrate/studio) and by the
// adapter's local-file fallback when TURSO_DATABASE_URL is unset - see
// README ".env 環境變數說明".
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SendStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Registration {
  id             String   @id @default(uuid())
  eventId        String   @unique @default(uuid())
  idempotencyKey String   @unique

  // form fields (see agatha-seminar-landing-0803.html #regform)
  name          String
  company       String
  taxId         String
  dept          String
  deptOther     String?
  title         String
  titleOther    String?
  industry      String
  industryOther String?
  size          String
  email         String
  phone         String
  // Json-encoded string[] - sqlite has no native array type. Under Postgres
  // this would be `String[]`; see the datasource note above.
  sessions      String
  stage         String
  stageOther    String?
  consult       String
  consultOther  String?
  agreeTerms    Boolean
  agreeMarketing Boolean @default(false)

  // acquisition / UTM (CTO handoff doc §4/§6.2)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?

  // downstream integration status (doc §6.3/§6.4)
  emailStatus     SendStatus @default(PENDING)
  emailSentAt     DateTime?
  metaCapiStatus  SendStatus @default(PENDING)
  metaCapiSentAt  DateTime?
  ragicSyncedAt   DateTime?

  // admin console (doc §6.2 "開後台權限給公關")
  reviewed     Boolean  @default(false)
  reviewerNote String?

  createdAt DateTime @default(now())

  @@index([utmSource, utmContent])
  @@index([createdAt])
  @@index([reviewed])
}

// PR-editable agenda (CTO handoff doc v3 §6.2 "後台 CMS" - agenda slice only,
// see openspec/changes/add-agenda-management). timeLabel is free text, not a
// structured start/end time: the approved design already treats time as a
// display string ("13:30–13:35") and sortOrder alone drives display order.
model AgendaItem {
  id        String   @id @default(uuid())
  timeLabel String
  title     String
  speaker   String?
  isBreak   Boolean  @default(false)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// Individual accounts (CTO handoff doc v3 §6.9: 給公關個別帳號，勿共用一組),
// replacing the V1 single shared ADMIN_PASSWORD - see
// openspec/changes/add-admin-accounts. Deactivate (not delete) on revoke, so
// AdminAuditLog.accountId stays valid.
enum AdminRole {
  CTO
  PR
}

model AdminAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  auditLogs AdminAuditLog[]
}

// V1 scope: only login + bulk export are logged (the two actions v3 §6.9
// actually cares about), not every CRUD click - see design.md Decisions.
model AdminAuditLog {
  id        String   @id @default(uuid())
  accountId String
  account   AdminAccount @relation(fields: [accountId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([createdAt])
}

// PR/CTO-editable content blocks (CTO handoff doc v3 §6.2 "後台 CMS" -
// speakers/partners/highlights slice, see openspec/changes/add-content-cms).
// Same shape/pattern as AgendaItem: explicit sortOrder, plain-text fields,
// no file upload yet - photoUrl/logoUrl are pasted URLs (see design.md).
model Speaker {
  id        String   @id @default(uuid())
  name      String
  title     String
  bio       String
  photoUrl  String?
  confirmed Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Partner {
  id          String   @id @default(uuid())
  name        String
  description String
  logoUrl     String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Highlight {
  id        String   @id @default(uuid())
  title     String
  body      String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// PR/CTO-editable registration form option lists (CTO handoff doc v3 §6.2 -
// "表單欄" slice, see openspec/changes/add-form-options-cms). Scope is
// deliberately limited to the VALUE CHOICES within each of the 7 existing
// fields, not the fields/layout themselves - see design.md Non-Goals. One
// model covers all 7 fields since they're all the same shape (a value +
// a sort position), distinguished by `field`.
enum FormOptionField {
  DEPT
  TITLE
  INDUSTRY
  SIZE
  SESSIONS
  STAGE
  CONSULT
}

model FormOption {
  id        String          @id @default(uuid())
  field     FormOptionField
  value     String
  sortOrder Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([field, value])
  @@index([field, sortOrder])
}

// Banner upload + Event Info CMS (CTO handoff doc v3 §6.2, this project's
// first real file upload - see openspec/changes/add-banner-event-info-cms).
// Both are FIXED-SLOT content, not orderable lists like every other CMS
// model above: there is always exactly one active banner and exactly 4
// event-info facts - see design.md for why that's a deliberate departure
// from the CRUD-list pattern.
model Banner {
  id         String   @id @default("singleton")
  desktopUrl String?
  mobileUrl  String?
  altText    String   @default("")
  updatedAt  DateTime @updatedAt
}

enum EventInfoField {
  DATE
  TIME
  VENUE
  ACCESS
}

model EventInfo {
  id        String         @id @default(uuid())
  field     EventInfoField @unique
  line1     String
  line2     String?
  subText   String?
  updatedAt DateTime       @updatedAt
}
